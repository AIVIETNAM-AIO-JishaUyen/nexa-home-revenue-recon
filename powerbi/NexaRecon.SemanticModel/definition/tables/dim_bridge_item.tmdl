/// Danh mục khoản cầu nối: mã, thứ tự, tên, nhóm. Đọc từ bảng q_BridgeItems của file Power Query để hai cách tính dùng chung một danh mục
table dim_bridge_item

	column item_code
		dataType: string
		summarizeBy: none
		sourceColumn: item_code

	column item_order
		dataType: int64
		summarizeBy: none
		sourceColumn: item_order

	column item_name
		dataType: string
		summarizeBy: none
		sourceColumn: item_name
		sortByColumn: item_order

	column item_group
		dataType: string
		summarizeBy: none
		sourceColumn: item_group

	/// Cột cho biểu đồ thác nước theo nhóm (trang 1): Flash, 4 nhóm lệch, Sổ cái; dòng kiểm tra để trống
	column nhom_thac_nuoc = SWITCH ( dim_bridge_item[item_code], "flash", "Flash", "gl", "Sổ cái", "check", BLANK (), dim_bridge_item[item_group] )
		dataType: string
		summarizeBy: none
		sortByColumn: thu_tu_nhom

	/// Thứ tự cột nhóm trên biểu đồ thác nước
	column thu_tu_nhom = SWITCH ( dim_bridge_item[item_code], "flash", 0, "gl", 5, "check", 9, SWITCH ( dim_bridge_item[item_group], "Quy tắc ghi nhận", 1, "Lỗi dữ liệu", 2, "Chưa giải thích được", 3, "Sai số chấp nhận", 4, 9 ) )
		dataType: int64
		summarizeBy: none

	partition dim_bridge_item = m
		mode: import
		source =
				let
				    Nguon = Excel.Workbook(File.Contents(PQFile), null, true),
				    LayBang = Nguon{[Item = "q_BridgeItems", Kind = "Table"]}[Data],
				    ChonCot = Table.SelectColumns(LayBang, {"item_code", "item_order", "item_name", "item_group"}),
				    DoiKieu = Table.TransformColumnTypes(ChonCot, {{"item_code", type text}, {"item_order", Int64.Type}, {"item_name", type text}, {"item_group", type text}}, "en-US")
				in
				    DoiKieu
