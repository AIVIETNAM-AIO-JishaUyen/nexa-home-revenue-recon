/// Tỷ giá cuối tháng
table fact_fx_month_end

	column period
		dataType: string
		summarizeBy: none
		sourceColumn: period

	column month_end_date
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: month_end_date

		annotation UnderlyingDateTimeDataType = Date

	column currency
		dataType: string
		summarizeBy: none
		sourceColumn: currency

	column usd_to_ccy
		dataType: double
		formatString: 0.00000
		summarizeBy: none
		sourceColumn: usd_to_ccy

	partition fact_fx_month_end = m
		mode: import
		source =
				let
				    Nguon = Excel.Workbook(File.Contents(DataFolder & "Nexa_Home_Recon_Dataset.xlsx"), null, true),
				    LaySheet = Nguon{[Item = "fact_fx_month_end", Kind = "Sheet"]}[Data],
				    DongDauLaTenCot = Table.PromoteHeaders(LaySheet, [PromoteAllScalars = true]),
				    DoiKieu = Table.TransformColumnTypes(DongDauLaTenCot, {{"period", type text}, {"month_end_date", type date}, {"currency", type text}, {"usd_to_ccy", type number}}, "en-US")
				in
				    DoiKieu

