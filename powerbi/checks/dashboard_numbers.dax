// Số chính của 4 trang dashboard: tháng 12/2025 (mặc định của bộ lọc tháng) và cả kỳ; để so với Power Query và số chuẩn
EVALUATE
VAR t12 = TREATAS ( { "2025-12" }, dim_date[period] )
RETURN
    ROW (
        "t12_flash", CALCULATE ( [Flash trong kỳ], t12 ),
        "t12_so_cai", CALCULATE ( [Sổ cái trong kỳ], t12 ),
        "t12_chenh_lech", CALCULATE ( [Chênh lệch trong kỳ], t12 ),
        "t12_pct", CALCULATE ( [% chênh lệch trong kỳ], t12 ),
        "t12_loi_du_lieu", CALCULATE ( [Nhóm lỗi dữ liệu], t12 ),
        "t12_so_voi_thang_truoc", CALCULATE ( [Thay đổi so với tháng trước (Chênh lệch)], t12 ),
        "ky_quy_tac", [Nhóm quy tắc ghi nhận],
        "ky_loi_du_lieu", [Nhóm lỗi dữ liệu],
        "ky_chua_giai_thich", [Nhóm chưa giải thích được],
        "ky_sai_so", [Nhóm sai số chấp nhận],
        "ky_chenh_lech", [Chênh lệch trong kỳ],
        "ky_con_lai", [Còn lại sau quy tắc ghi nhận],
        "ky_lech_dax_pq", [Lệch tổng DAX − Power Query],
        "ky_so_o", [Số ô cửa hàng × ngày],
        "ky_o_lech_ngay_ghi_so", [Số ô lệch theo ngày ghi sổ],
        "ky_o_lech_ngay_ban", [Số ô lệch theo ngày bán],
        "t11_online_ngay_dat", CALCULATE ( [Chênh lệch online theo ngày đặt], TREATAS ( { "2025-11" }, dim_date[period] ) ),
        "t11_online_ngay_giao", CALCULATE ( [Chênh lệch online theo ngày giao], TREATAS ( { "2025-11" }, dim_date[period] ) ),
        "ky_dong_trung", [Số dòng POS trùng],
        "ky_don_huy", [Số đơn hủy],
        "ky_but_toan_tay", [Số bút toán tay],
        "ky_hang_tra", [Hàng trả],
        "ky_ty_le_tra", [Tỷ lệ hàng trả],
        "nuoc_canada_flash", CALCULATE ( [Flash trong kỳ], dim_store[country] = "Canada" ),
        "diem_chinh_1", CALCULATE ( [Điểm chính trang 1], t12 ),
        "diem_chinh_2", [Điểm chính trang 2],
        "diem_chinh_3", [Điểm chính trang 3],
        "diem_chinh_4", CALCULATE ( [Điểm chính trang 4], t12 ),
        "tieu_de_1a", [Tiêu đề (Flash và sổ cái)],
        "tieu_de_1b", [Tiêu đề (thác nước theo nhóm)],
        "tieu_de_1c", [Tiêu đề (% chênh lệch theo tháng)],
        "tieu_de_1d", [Tiêu đề (còn lại sau quy tắc)],
        "tieu_de_2a", [Tiêu đề (thác nước từng khoản)],
        "tieu_de_2b", [Tiêu đề (xếp hạng khoản)],
        "tieu_de_2c", [Tiêu đề (đối chiếu)],
        "tieu_de_3a", [Tiêu đề (chênh lệch cửa hàng)],
        "tieu_de_3b", [Tiêu đề (chênh lệch online)],
        "tieu_de_4a", [Tiêu đề (tỷ lệ hàng trả)],
        "tieu_de_4c", [Tiêu đề (bút toán tay)]
    )
