% ---- Ngon ngu "Excel" cho cac khoi cong thuc -----------------
\lstdefinelanguage{Excel}{
  morekeywords={IF,IFS,IFERROR,AND,OR,NOT,TRUE,FALSE,
    SUM,SUMPRODUCT,ROUND,POWER,LOG10,LOG,EXP,ABS,MAX,MIN,
    COUNT,COUNTA,COUNTIF,COUNTIFS,COUNTBLANK,QUARTILE,AVERAGE,MEDIAN,MODE,
    STDEV,VAR,CORREL,VLOOKUP,HLOOKUP,INDEX,MATCH,SEARCH,FIND,
    VALUE,TEXT,LEFT,RIGHT,MID,LEN,TRIM,CLEAN,LOWER,UPPER,PROPER,SUBSTITUTE,
    DATE,DAY,MONTH,YEAR,ISNUMBER,ISTEXT,ISBLANK,LET,SWITCH,NA},
  sensitive=false,
  morestring=[b]",
  morecomment=[l]{//},
}
\endinput
